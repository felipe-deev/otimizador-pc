{
  "name": "otimizador-pc",
  "productName": "Otimizador PC",
  "version": "1.0.0",
  "description": "Otimizador para Windows: remove apps desnecessários, controla a inicialização e limpa arquivos inúteis.",
  "main": "src/main.js",
  "author": "Felipe Borges de Lima",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.felipedeev.otimizadorpc",
    "productName": "Otimizador PC",
    "copyright": "Copyright © 2026 Felipe Borges de Lima. Todos os direitos reservados.",
    "directories": {
      "output": "programa"
    },
    "asar": false,
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
